# Net Sentinel Configuration - Software Vantage

# Web Server Configuration
NETSENTINEL_HOST=127.0.0.1
NETSENTINEL_PORT=8000

# Security Secret Key (Replace with a random 32-character string in production)
NETSENTINEL_SECRET=change-this-to-a-secure-random-secret-key-32chars

# Router Configuration
# Default IP address of the DBC HGU-V210-4AC router
NETSENTINEL_ROUTER_IP=192.168.1.1
NETSENTINEL_ROUTER_USER=admin
NETSENTINEL_ROUTER_PASS=

# Network Discovery Settings
NETSENTINEL_SCAN_TIMEOUT=10
NETSENTINEL_THREADS=50
NETSENTINEL_SCAN_INTERVAL=15
